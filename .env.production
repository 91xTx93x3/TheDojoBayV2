# Dojobay External API - Production Environment Configuration
# For systemd: Do NOT use export here
# For shell scripts: source this file as: source .env.production

# ═══════════════════════════════════════════════════════════════════
# SECURITY - CRITICAL: Set these before production deployment
# ═══════════════════════════════════════════════════════════════════

# API Token for authentication (Bearer token)
# Generate with: openssl rand -hex 32
DOJOBAY_API_TOKEN=e3a15e137191a5016644dfb6f6fe4f7c7dac2156157a0b4bfcd73bc5614727d7

# ═══════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Bind address and port
# Use 0.0.0.0 to listen on all interfaces (behind a reverse proxy)
# Use 127.0.0.1 for local only (development)
DOJOBAY_BIND=127.0.0.1:8090

# Number of worker processes
# Rule of thumb: (2 × CPU cores) + 1
DOJOBAY_WORKERS=4

# ═══════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Log level: debug, info, warning, error, critical
DOJOBAY_API_LOG_LEVEL=info

# Log file paths
# Use "-" for stdout/stderr (recommended with systemd)
DOJOBAY_ACCESS_LOG=./external_api_access.log
DOJOBAY_ERROR_LOG=./external_api_error.log

# ═══════════════════════════════════════════════════════════════════
# GUNICORN CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Worker class: sync, gevent, eventlet, tornado
DOJOBAY_WORKER_CLASS=sync

# Maximum number of requests per worker before recycling
DOJOBAY_MAX_REQUESTS=10000

# Jitter for max requests (prevents thundering herd)
DOJOBAY_MAX_REQUESTS_JITTER=1000

# Worker timeout (seconds)
DOJOBAY_WORKER_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════════
# PROCESS MANAGEMENT (when running as daemon)
# ═══════════════════════════════════════════════════════════════════

# PID file location (optional)
# export DOJOBAY_PID_FILE="/var/run/dojobay-api.pid"

# Run as specific user/group (optional, usually for systemd)
# export DOJOBAY_USER="www-data"
# export DOJOBAY_GROUP="www-data"

# ═══════════════════════════════════════════════════════════════════
# DEBUGGING & MONITORING
# ═══════════════════════════════════════════════════════════════════

# Debug mode - NEVER set to true in production!
# Only set to false (default)
export DOJOBAY_API_DEBUG="false"
