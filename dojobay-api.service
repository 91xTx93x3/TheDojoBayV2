[Unit]
Description=Dojobay External API Service
Documentation=file:///root/dojobay/EXTERNAL_API_DEPLOYMENT.md
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/dojobay
EnvironmentFile=/root/dojobay/.env.production
Environment="PATH=/root/dojobay/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/bin/bash -c 'cd /root/dojobay && source venv/bin/activate && python -m gunicorn -c gunicorn_external_api_prod.conf.py external_api:app'

Restart=always
RestartSec=5
StartLimitInterval=600s
StartLimitBurst=3

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dojobay-api

[Install]
WantedBy=multi-user.target
